{
  "id": null,
  "uid": "http-metrics-monitoring",
  "title": "HTTP Metrics Monitoring",
  "tags": ["http", "microservices", "monitoring"],
  "style": "dark",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Requests per Second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=~\"$service\", method=~\"$method\", status=~\"$status\"}[5m])) by (service, method)",
          "legendFormat": "{{service}} - {{method}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 2,
      "title": "Error Rate (4xx/5xx)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": "12", "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=~\"$service\", status=~\"5..\"}[5m])) by (service, status)",
          "legendFormat": "{{service}} - {{status}} (5xx)",
          "interval": "15s"
        },
        {
          "expr": "sum(rate(http_requests_total{service=~\"$service\", status=~\"4..\"}[5m])) by (service, status)",
          "legendFormat": "{{service}} - {{status}} (4xx)",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 3,
      "title": "Response Time - 95th Percentile",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=~\"$service\", method=~\"$method\"}[5m])) by (le, service, method))",
          "legendFormat": "{{service}} - {{method}} - p95",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      }
    },
    {
      "id": 4,
      "title": "Response Time - 50th Percentile",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=~\"$service\", method=~\"$method\"}[5m])) by (le, service, method))",
          "legendFormat": "{{service}} - {{method}} - p50",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      }
    },
    {
      "id": 5,
      "title": "Top Endpoints by Request Volume",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "topk(10, sum(rate(http_requests_total{service=~\"$service\"}[5m])) by (service, method, path))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{service}} {{method}} {{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "title": "Top Endpoints by Error Rate",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "topk(10, sum(rate(http_requests_total{service=~\"$service\", status=~\"5..\"}[5m])) by (service, method, path, status))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{service}} {{method}} {{path}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 7,
      "title": "Response Time Heatmap by Endpoint",
      "type": "heatmap",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=~\"$service\"}[5m])) by (le, path))",
          "legendFormat": "{{path}}",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 8,
      "title": "Current Status Code Distribution",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=~\"$service\"}[5m])) by (status)",
          "legendFormat": "{{status}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 9,
      "title": "Error Percentage by Service",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 32},
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{service=~\"$service\", status=~\"5..\"}[5m])) by (service) / sum(rate(http_requests_total{service=~\"$service\"}[5m])) by (service)) * 100",
          "legendFormat": "{{service}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Total Requests Today",
      "type": "stat",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 32},
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{service=~\"$service\"}[24h]))",
          "legendFormat": "Total",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "id": 11,
      "title": "Average Response Time",
      "type": "stat",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 32},
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum{service=~\"$service\"}[5m])) / sum(rate(http_request_duration_seconds_count{service=~\"$service\"}[5m]))",
          "legendFormat": "Avg",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_requests_total, service)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "method",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_requests_total, method)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "status",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_requests_total, status)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "path",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_requests_total, path)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "refresh": "15s"
}