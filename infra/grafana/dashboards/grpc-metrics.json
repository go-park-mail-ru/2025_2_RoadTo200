{
  "id": null,
  "uid": "grpc-metrics-monitoring",
  "title": "gRPC Metrics Monitoring",
  "tags": ["grpc", "microservices", "monitoring"],
  "style": "dark",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "gRPC Requests per Second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(grpc_server_started_total{grpc_service=~\"$service\", grpc_type=~\"$type\"}[5m])) by (grpc_service, grpc_method)",
          "legendFormat": "{{grpc_service}}/{{grpc_method}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 2,
      "title": "gRPC Response Status Codes",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(grpc_server_handled_total{grpc_service=~\"$service\", grpc_code=~\"OK\"}[5m])) by (grpc_service, grpc_method)",
          "legendFormat": "{{grpc_service}}/{{grpc_method}} - OK",
          "interval": "15s"
        },
        {
          "expr": "sum(rate(grpc_server_handled_total{grpc_service=~\"$service\", grpc_code=~\"Unknown|Internal|Unavailable\"}[5m])) by (grpc_service, grpc_method, grpc_code)",
          "legendFormat": "{{grpc_service}}/{{grpc_method}} - {{grpc_code}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 3,
      "title": "gRPC Response Time - 95th Percentile",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(grpc_server_handling_seconds_bucket{grpc_service=~\"$service\"}[5m])) by (le, grpc_service, grpc_method))",
          "legendFormat": "{{grpc_service}}/{{grpc_method}} - p95",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      }
    },
    {
      "id": 4,
      "title": "gRPC Response Time - 50th Percentile",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(grpc_server_handling_seconds_bucket{grpc_service=~\"$service\"}[5m])) by (le, grpc_service, grpc_method))",
          "legendFormat": "{{grpc_service}}/{{grpc_method}} - p50",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      }
    },
    {
      "id": 5,
      "title": "gRPC Error Rate by Method",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(grpc_server_handled_total{grpc_service=~\"$service\", grpc_code!~\"OK\"}[5m])) by (grpc_service, grpc_method, grpc_code)",
          "legendFormat": "{{grpc_service}}/{{grpc_method}} - {{grpc_code}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 6,
      "title": "gRPC Messages Streaming",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(grpc_server_msg_received_total{grpc_service=~\"$service\"}[5m])) by (grpc_service, grpc_method)",
          "legendFormat": "{{grpc_service}}/{{grpc_method}} - Received",
          "interval": "15s"
        },
        {
          "expr": "sum(rate(grpc_server_msg_sent_total{grpc_service=~\"$service\"}[5m])) by (grpc_service, grpc_method)",
          "legendFormat": "{{grpc_service}}/{{grpc_method}} - Sent",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "msgps",
          "min": 0
        }
      }
    },
    {
      "id": 7,
      "title": "Top gRPC Methods by Request Volume",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "topk(10, sum(rate(grpc_server_started_total{grpc_service=~\"$service\"}[5m])) by (grpc_service, grpc_method, grpc_type))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{grpc_service}} {{grpc_method}} ({{grpc_type}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 8,
      "title": "Top gRPC Methods by Error Rate",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "expr": "topk(10, sum(rate(grpc_server_handled_total{grpc_service=~\"$service\", grpc_code!~\"OK\"}[5m])) by (grpc_service, grpc_method, grpc_code))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{grpc_service}} {{grpc_method}} ({{grpc_code}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 9,
      "title": "gRPC Response Time Heatmap",
      "type": "heatmap",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(grpc_server_handling_seconds_bucket{grpc_service=~\"$service\"}[5m])) by (le, grpc_method))",
          "legendFormat": "{{grpc_method}}",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 10,
      "title": "Current gRPC Status Distribution",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "targets": [
        {
          "expr": "sum(rate(grpc_server_handled_total{grpc_service=~\"$service\"}[5m])) by (grpc_code)",
          "legendFormat": "{{grpc_code}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 11,
      "title": "gRPC Error Percentage",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 40},
      "targets": [
        {
          "expr": "(sum(rate(grpc_server_handled_total{grpc_service=~\"$service\", grpc_code!~\"OK\"}[5m])) by (grpc_service) / sum(rate(grpc_server_handled_total{grpc_service=~\"$service\"}[5m])) by (grpc_service)) * 100",
          "legendFormat": "{{grpc_service}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Active gRPC Streams",
      "type": "stat",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 40},
      "targets": [
        {
          "expr": "sum(grpc_server_started_total{grpc_service=~\"$service\", grpc_type=~\"SERVER_STREAMING|BIDI_STREAMING\"}) - sum(grpc_server_handled_total{grpc_service=~\"$service\", grpc_type=~\"SERVER_STREAMING|BIDI_STREAMING\"})",
          "legendFormat": "Active Streams",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      }
    },
    {
      "id": 13,
      "title": "Avg gRPC Response Time",
      "type": "stat",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 40},
      "targets": [
        {
          "expr": "sum(rate(grpc_server_handling_seconds_sum{grpc_service=~\"$service\"}[5m])) / sum(rate(grpc_server_handling_seconds_count{grpc_service=~\"$service\"}[5m]))",
          "legendFormat": "Avg Response Time",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(grpc_server_started_total, grpc_service)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "method",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(grpc_server_started_total, grpc_method)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "type",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(grpc_server_started_total, grpc_type)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "code",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(grpc_server_handled_total, grpc_code)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "refresh": "15s"
}